# Copy to /etc/branchforge/dispatcher.env on the deployment host.
# chown root:branchforge-dispatcher /etc/branchforge/dispatcher.env
# chmod 0640 /etc/branchforge/dispatcher.env
# Loaded by branchforge-dispatcher.service via systemd's EnvironmentFile=.
# Holds the ANTHROPIC_API_KEY, so only the dispatcher account may read it —
# do not also grant branchforge-api read access to this file.

# Absolute path. Must be byte-for-byte identical to DATABASE_URL in
# api.env — see the comment there for why.
DATABASE_URL=sqlite:////var/lib/branchforge/db/branchforge.db

# Not a BranchForge setting — this is the OS-level TMPDIR environment
# variable. Orchestration workspaces are created with
# tempfile.mkdtemp(prefix="branchforge-orch-") (app/orchestrator.py), which
# honours TMPDIR; there is no workspace-root config field. Point it at
# persistent local disk rather than the OS default so verification workspaces
# don't land on tmpfs or an ephemeral volume.
TMPDIR=/var/lib/branchforge/workspaces

# --- GitHub inspection (milestone 2) ----------------------------------------
# The worker reads public repositories anonymously. GitHub allows roughly
# 60 requests/hour per IP, and one inspection costs 3 + n requests
# (metadata, commit, tree, plus one per file fetched).
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER_AGENT=BranchForge/0.2

GITHUB_REQUEST_TIMEOUT_SECONDS=10.0
GITHUB_CONNECT_TIMEOUT_SECONDS=5.0

# Hard ceiling on requests per inspection.
GITHUB_MAX_REQUESTS=20

# Raw HTTP response caps, enforced while streaming and before JSON parsing.
# GitHub caps a recursive tree at 7 MB; base64 inflates file content by 4/3.
GITHUB_MAX_RESPONSE_BYTES=8000000
GITHUB_MAX_CONTENT_RESPONSE_BYTES=262144

# Decoded-content budgets.
GITHUB_MAX_FILE_BYTES=100000
GITHUB_MAX_TOTAL_CONTENT_BYTES=400000

# Report shaping. The file listing is display-only and does not affect which
# files are selected for preview.
GITHUB_MAX_FILES_LISTED=500
GITHUB_MAX_FILES_FETCHED=8

# --- Patch-proposal agent (milestone 3) -------------------------------------
# Required by `worker propose` / `worker orchestrate`. Get a key from
# https://console.anthropic.com/ and paste it here directly on the server —
# never commit a real key, never paste it into chat or a ticket.
ANTHROPIC_API_KEY=
# A model identifier your account has access to.
ANTHROPIC_MODEL=claude-opus-5

# Per HTTP request, NOT a deadline for the whole attempt — the turn and
# tool-call limits below bound that. Implicit SDK retries are disabled.
AGENT_REQUEST_TIMEOUT_SECONDS=120.0

AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12
# When the turn budget runs out right after a rejected submission, this many
# extra turns follow in which only submit_patch is accepted. 0 disables them.
AGENT_MAX_PATCH_REPAIR_TURNS=2

AGENT_MAX_FILE_BYTES=60000
AGENT_MAX_TOTAL_FETCHED_BYTES=200000

# Output tokens per model call. A response cut off at this limit is recorded as
# a failure, never stored as a partial patch.
AGENT_MAX_OUTPUT_TOKENS=16000

# Context is measured with the provider's token-counting endpoint before every
# generation. Two ceilings apply and the SMALLER one wins:
#   1. AGENT_MAX_CONTEXT_TOKENS      — an explicit application limit, and
#   2. AGENT_MODEL_CONTEXT_TOKENS minus the output reservation and the margin.
# Keeping (1) explicit means moving to a model with a bigger window does not
# silently licence a much bigger (and more expensive) attempt.
AGENT_MAX_CONTEXT_TOKENS=150000
AGENT_MODEL_CONTEXT_TOKENS=1000000
AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=8000

# Bounds on everything persisted.
AGENT_MAX_PATCH_BYTES=60000
AGENT_MAX_SUMMARY_CHARS=4000
AGENT_MAX_TEST_COMMAND_CHARS=500
AGENT_MAX_ERROR_CHARS=2000
AGENT_MAX_EVENTS=200
AGENT_MAX_EVENT_DETAIL_CHARS=2000

# --- Patch verification (milestone 4) ---------------------------------------
# Requires Docker and the runner image, built once on this host from the repo
# root:
#   docker build --provenance=false -t branchforge-runner-python:1 backend/runner/python-pytest
# The tag is resolved to an immutable image ID once per verification, and that
# exact ID runs the baseline, comparison, and supplemental phases.
VERIFY_PROFILE=python-pytest
VERIFY_IMAGE=branchforge-runner-python:1
VERIFY_DOCKER_BINARY=docker

# Source snapshot: a tar.gz of one exact commit from codeload.github.com.
VERIFY_MAX_DOWNLOAD_BYTES=80000000
# Counted on the DECOMPRESSED stream, tar headers included, so a compression
# bomb is bounded by what reading it costs rather than by declared file sizes.
VERIFY_MAX_DECOMPRESSED_BYTES=400000000
VERIFY_MAX_SNAPSHOT_FILES=20000
VERIFY_SNAPSHOT_DEADLINE_SECONDS=180.0

# Container ceilings. The wall-clock timeout applies to each test run; on expiry
# the container is force-removed.
VERIFY_CONTAINER_MEMORY=512m
VERIFY_CONTAINER_CPUS=1.0
VERIFY_CONTAINER_PIDS=256
VERIFY_CONTAINER_TMPFS_BYTES=67108864
VERIFY_TEST_TIMEOUT_SECONDS=300.0
VERIFY_CLEANUP_TIMEOUT_SECONDS=30.0
VERIFY_GIT_TIMEOUT_SECONDS=60.0

# Bounds on everything captured or persisted. Container output is capped while
# streaming, and the reader keeps draining past the cap so a full pipe cannot
# hang the run.
VERIFY_MAX_LOG_BYTES=200000
VERIFY_MAX_REPORT_BYTES=5000000
VERIFY_REPORT_MAX_TESTS=5000
VERIFY_REPORT_MAX_MESSAGE_CHARS=400
VERIFY_MAX_ERROR_CHARS=2000

# --- Orchestration (milestone 5) --------------------------------------------
# How many attempt pipelines (propose -> verify) ONE orchestrator process runs
# at once, 1-3. The effective value is min(this, the run's
# max_parallel_attempts). Per process — not a global capacity limit.
# Every ANTHROPIC_MODEL, AGENT_*, GITHUB_*, and VERIFY_* value above is frozen
# on the orchestration when it starts, so all of its attempts use the same ones.
ORCHESTRATOR_MAX_CONCURRENCY=2
# On Ctrl+C/SIGTERM: seconds a child gets after SIGTERM before SIGKILL.
ORCHESTRATOR_CHILD_GRACE_SECONDS=10.0
# After a child exits, how long its output reader may take to reach EOF.
ORCHESTRATOR_DRAIN_TIMEOUT_SECONDS=10.0
# Child output is relayed line by line; longer lines are cut to this.
ORCHESTRATOR_MAX_RELAYED_LINE_CHARS=2000

# --- Execution queue (milestone 6) ------------------------------------------
# Settings for `uv run python -m app.worker dispatch`. These are dispatcher
# policy, not per-orchestration execution settings, so they are NOT frozen
# onto an orchestration the way ANTHROPIC_MODEL, AGENT_*, GITHUB_*, and
# VERIFY_* are.
#
# There is deliberately no lock-path setting. The dispatcher's single-instance
# lock is an OS file lock derived from the resolved SQLite database file
# (realpath(DATABASE_URL) + ".dispatcher.lock"), so that two spellings of one
# database cannot produce two locks and two dispatchers. This is a
# single-host arrangement: flock does not carry these semantics over NFS.
#
# How often the queue is checked when there is nothing to do.
DISPATCHER_POLL_SECONDS=2.0
# How often an active job's cancellation flag is re-read while a child runs.
DISPATCHER_CANCEL_POLL_SECONDS=0.5
# Seconds a child gets after SIGTERM before SIGKILL. Keep this comfortably
# above ORCHESTRATOR_CHILD_GRACE_SECONDS + ORCHESTRATOR_DRAIN_TIMEOUT_SECONDS +
# VERIFY_CLEANUP_TIMEOUT_SECONDS: on SIGTERM an orchestrator spends up to that
# long saving its comparison and sweeping its containers, and killing it
# sooner throws that work away and leaves containers for the dispatcher to
# clean up. The systemd unit's TimeoutStopSec must in turn exceed this value.
DISPATCHER_CHILD_GRACE_SECONDS=90.0
# After a child exits, how long its output reader may take to hit EOF.
DISPATCHER_DRAIN_TIMEOUT_SECONDS=10.0
# How long an orphaned attempt worker gets after SIGTERM before SIGKILL.
# Reached only when an orchestrator had to be killed: its attempt children
# lead their own sessions and survive it.
DISPATCHER_WORKER_GRACE_SECONDS=10.0
# Cap on the operator notes kept on one job, so repeated dispatcher restarts
# cannot grow the row without limit.
DISPATCHER_MAX_JOB_NOTES=20

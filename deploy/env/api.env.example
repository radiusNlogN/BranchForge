# Copy to /etc/branchforge/api.env on the deployment host.
# chown root:branchforge-api /etc/branchforge/api.env
# chmod 0640 /etc/branchforge/api.env
# Loaded by branchforge-api.service via systemd's EnvironmentFile=. Contains
# no secrets — the API process never calls the model or Docker, so
# ANTHROPIC_API_KEY is intentionally absent here (it lives only in
# dispatcher.env) to keep this account's exposure surface smaller.

# Absolute path. Must be byte-for-byte identical to DATABASE_URL in
# dispatcher.env — both services must resolve to the exact same file, and
# there is no other mechanism (no shared config, no override setting) that
# keeps them in sync. See deploy/README.md's install step 5 for the
# permissions this file needs before either service can write it.
DATABASE_URL=sqlite:////var/lib/branchforge/db/branchforge.db

# The public origin Caddy serves this deployment on (must match the domain in
# /etc/caddy/Caddyfile). In production, requests to this API arrive
# same-origin through Caddy's reverse proxy, so the browser never sends a
# cross-origin request in the first place — this is defense-in-depth, not
# what makes the app reachable.
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN

# Bounds for GET /api/runs?limit=. RUN_LIST_MAX_LIMIT must stay >= 25: the
# dashboard requests 25 runs per list call.
RUN_LIST_DEFAULT_LIMIT=25
RUN_LIST_MAX_LIMIT=100

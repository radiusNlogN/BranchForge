[Unit]
Description=BranchForge API (FastAPI, uvicorn)
After=network.target
# Started before the dispatcher purely to keep startup order predictable —
# the dispatcher does not depend on the API being up.
Before=branchforge-dispatcher.service

[Service]
Type=simple
User=branchforge-api
Group=branchforge
WorkingDirectory=/opt/branchforge/backend
EnvironmentFile=/etc/branchforge/api.env
UMask=0002

# Loopback-only and no --reload: the backend port is never exposed off-host,
# and dev auto-reload has no place in a persistent service. Caddy is the only
# public entry point (see deploy/Caddyfile).
ExecStart=/usr/local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# This unit never talks to Docker, so it can be sandboxed without risking the
# dockerd bind-mount mismatch documented on the dispatcher unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/branchforge/db

[Install]
WantedBy=multi-user.target

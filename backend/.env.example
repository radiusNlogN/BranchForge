# Copy to backend/.env and adjust as needed. Contains no secrets.

# SQLAlchemy database URL. Relative SQLite paths resolve against the directory
# you launch the backend from, so run backend commands from `backend/`.
DATABASE_URL=sqlite:///./branchforge.db

# Comma-separated list of browser origins allowed to call this API.
# These are the default Vite dev-server origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bounds for GET /api/runs?limit=
RUN_LIST_DEFAULT_LIMIT=25
RUN_LIST_MAX_LIMIT=100

# --- GitHub inspection (milestone 2) ----------------------------------------
# The worker reads public repositories anonymously. GitHub allows roughly
# 60 requests/hour per IP, and one inspection costs 3 + n requests
# (metadata, commit, tree, plus one per file fetched).
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER_AGENT=BranchForge/0.2

GITHUB_REQUEST_TIMEOUT_SECONDS=10.0
GITHUB_CONNECT_TIMEOUT_SECONDS=5.0

# Hard ceiling on requests per inspection.
GITHUB_MAX_REQUESTS=20

# Raw HTTP response caps, enforced while streaming and before JSON parsing.
# GitHub caps a recursive tree at 7 MB; base64 inflates file content by 4/3.
GITHUB_MAX_RESPONSE_BYTES=8000000
GITHUB_MAX_CONTENT_RESPONSE_BYTES=262144

# Decoded-content budgets.
GITHUB_MAX_FILE_BYTES=100000
GITHUB_MAX_TOTAL_CONTENT_BYTES=400000

# Report shaping. The file listing is display-only and does not affect which
# files are selected for preview.
GITHUB_MAX_FILES_LISTED=500
GITHUB_MAX_FILES_FETCHED=8

# --- Patch-proposal agent (milestone 3) -------------------------------------
# Required by `worker propose`. Get a key from https://console.anthropic.com/
# and export it (or put it here) — never commit a real key.
ANTHROPIC_API_KEY=
# A model identifier your account has access to.
ANTHROPIC_MODEL=claude-opus-5

# Per HTTP request, NOT a deadline for the whole attempt — the turn and
# tool-call limits below bound that. Implicit SDK retries are disabled.
AGENT_REQUEST_TIMEOUT_SECONDS=120.0

AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12

AGENT_MAX_FILE_BYTES=60000
AGENT_MAX_TOTAL_FETCHED_BYTES=200000

# Output tokens per model call. A response cut off at this limit is recorded as
# a failure, never stored as a partial patch.
AGENT_MAX_OUTPUT_TOKENS=16000

# Context is measured with the provider's token-counting endpoint before every
# generation. The usable input budget is the context window minus the output
# reservation and the safety margin.
AGENT_MODEL_CONTEXT_TOKENS=1000000
AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=8000

# Bounds on everything persisted.
AGENT_MAX_PATCH_BYTES=60000
AGENT_MAX_SUMMARY_CHARS=4000
AGENT_MAX_TEST_COMMAND_CHARS=500
AGENT_MAX_ERROR_CHARS=2000
AGENT_MAX_EVENTS=200
AGENT_MAX_EVENT_DETAIL_CHARS=2000

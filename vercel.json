{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "buildCommand": "VITE_API_BASE_URL= npm run build"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://34-61-91-141.sslip.io/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
